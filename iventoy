networks:
  iventoy-net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.102.0/24
services:
  iventoy:
    networks:
      iventoy-net:
        ipv4_address: 172.20.102.10
    image: garybowers/iventoy:latest
    container_name: iventoy
    restart: unless-stopped
    privileged: true #must be true
    ports:
      - 26000:26000
      - 16000:16000
      - 10809:10809
      #      - 67:67/udp
      - 69:69/udp
    volumes:
      - /dockermp/iventoy/iventoy-iso:/iventoy/iso
      - /dockermp/iventoy/iventoy-log:/iventoy/log
      - /dockermp/iventoy/iventoy-settings:/iventoy/data
    environment:
      - IVENTOY_AUTO_RUN=1
      - TZ=America/Chicago
